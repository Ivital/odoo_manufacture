#. module: mrp_propagate_lot_info
#. odoo-python
#: code:addons/mrp_propagate_lot_info/models/mrp_production.py:0
msgid "Lot field propagation requires a finished product lot/serial number."
msgstr ""
"Передавання поля партії потребує партії/серійного номера готового товару."

#. module: mrp_propagate_lot_info
#. odoo-python
#: code:addons/mrp_propagate_lot_info/models/mrp_production.py:0
